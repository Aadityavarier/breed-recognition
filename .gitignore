# ================================
# PYTHON CACHE & VENV
# ================================
__pycache__/
*.pyc
*.pyo
*.pyd
.Python
*.so
*.egg
*.egg-info/
dist/
build/
.pytest_cache/

venv/
env/
.venv/

# ================================
# RUNTIME DATA & DATABASES
# ================================
data/*.db
data/*.sqlite
data/*.sqlite3
cattle_records.db

# Ensure Python modules in data/ are tracked
!data/__init__.py
!data/db.py

# ================================
# UPLOADED SCANS (KEEP DIR VIA GITKEEP)
# ================================
expert-dashboard/static/uploads/*
!expert-dashboard/static/uploads/.gitkeep

# ================================
# LARGE MODEL WEIGHT BINARIES
# ================================
*.h5
*.keras
*.pt
*.tflite
*.onnx
*.weights

models/final_optimized/
models/saved/
models/checkpoints/
models/logs/

# ================================
# ENVIRONMENT VARIABLES & CREDENTIALS
